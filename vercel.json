{
  "version": 2,
  "routes": [
    {
      "src": "/guide\\-pratiche/sostituzione\\-infissi\\-documenti\\-prima\\-acconto/?",
      "status": 301,
      "headers": {
        "Location": "/articoli/sostituzione-infissi-documenti-prima-acconto.html"
      }
    },
    {
      "src": "/speciali\\-aziende/renova\\-solution\\-scegliere\\-le\\-nuove\\-finestre\\-partendo\\-dai\\-vani/?",
      "status": 301,
      "headers": {
        "Location": "/articoli/renova-solution-scegliere-le-nuove-finestre-partendo-dai-vani.html"
      }
    },
    {
      "src": "/speciali\\-aziende/nuove\\-finestre\\-e\\-climatizzazione\\-il\\-confronto\\-da\\-aprire\\-con\\-innovasol/?",
      "status": 301,
      "headers": {
        "Location": "/articoli/nuove-finestre-e-climatizzazione-il-confronto-da-aprire-con-innovasol.html"
      }
    },
    {
      "src": "/speciali\\-aziende/green\\-energy\\-group\\-la\\-domotica\\-comincia\\-dalle\\-abitudini\\-di\\-casa/?",
      "status": 301,
      "headers": {
        "Location": "/articoli/green-energy-group-la-domotica-comincia-dalle-abitudini-di-casa.html"
      }
    },
    {
      "src": "/guide\\-pratiche/?",
      "status": 301,
      "headers": {
        "Location": "/news.html"
      }
    },
    {
      "src": "/speciali\\-aziende/?",
      "status": 301,
      "headers": {
        "Location": "/news.html"
      }
    },
    {
      "src": "/top-10.html",
      "status": 301,
      "headers": {
        "Location": "/classifiche.html#top-10"
      }
    },
    {
      "src": "/top-5-produttori.html",
      "status": 301,
      "headers": {
        "Location": "/classifiche.html"
      }
    },
    {
      "src": "/(css|js)/(.*)",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/(assets|fonts)/(.*)",
      "headers": {
        "cache-control": "public, max-age=3600"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "x-content-type-options": "nosniff",
        "referrer-policy": "strict-origin-when-cross-origin",
        "x-frame-options": "SAMEORIGIN",
        "permissions-policy": "geolocation=(), microphone=(), camera=(), browsing-topics=()"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null
}
